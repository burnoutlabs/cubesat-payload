# Normalize line endings; checkout/commit as LF
* text=auto eol=lf

# Shell scripts must stay LF
*.sh text eol=lf

# Generated/lock files
go.sum linguist-generated
*.lock linguist-generated

# CAD build outputs are binary; never diff or normalise them
*.stl binary
*.3mf binary
*.step binary
*.stp binary

# Generated from data/ by tools/gen_params.py; collapse in review diffs
scad/generated/** linguist-generated
